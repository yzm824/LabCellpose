<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- The app arrives as a downloaded ZIP: its own libraries beside the program must load although Windows
         marks every unpacked file as coming from the internet. -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
